# ============================================================
# CAPY BUG HUNTER — Environment Configuration
# ============================================================
# Copy to .env and fill in your values

# --- LLM Provider ---
# Options: anthropic, openai, deepseek, openrouter, nous-portal, huggingface, custom
HERMES_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# --- Provider Fallbacks (for cost optimization) ---
# RN D / Analysis tasks → cheaper model
HERMES_RND_MODEL=claude-sonnet-4-6
# Strategy / Planning → balanced
HERMES_STRATEGY_MODEL=claude-sonnet-4-6
# Execution / Scanning → cheap & fast
HERMES_EXECUTION_MODEL=claude-haiku-4-5
# CEO / Orchestration → best reasoning
HERMES_CEO_MODEL=claude-opus-4-7

# --- Tool API Keys (optional but recommended) ---
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
GITHUB_TOKEN=
ETHERSCAN_API_KEY=
INFURA_API_KEY=

# --- Target Platforms ---
HACKERONE_USERNAME=
HACKERONE_API_TOKEN=
IMMUNEFI_API_KEY=

# --- Security ---
# NEVER set KILL_SWITCH_DISABLED=true in production
KILL_SWITCH_DISABLED=false
MAX_REQUESTS_PER_SECOND=5
MAX_CONCURRENT_SCANS=3

# --- Audit & Logging ---
AUDIT_LOG_LEVEL=info
AUDIT_RETENTION_DAYS=90
